{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/recordar-estado.sh\"",
            "timeout": 10,
            "statusMessage": "Revisando si el estado del proyecto está al día…"
          }
        ]
      }
    ]
  }
}
