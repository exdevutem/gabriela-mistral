# No hay chat: ella sólo responde las preguntas frecuentes, grabadas al
# arrancar. Lo que el visitante dice lo transcribe Whisper y lo empareja un
# modelo de embeddings, ambos locales y descargados de Hugging Face la primera
# vez (~1,5 GB).
# WHISPER_MODELO=openai/whisper-small
# EMBEDDINGS_MODELO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# UMBRAL=0.5            # parecido mínimo; por debajo dice «no te entendí»

# Quién graba las respuestas: neutts (clona la referencia, por defecto), piper
# o gemini (voz prefabricada; su nivel gratuito da 10 peticiones al día).
# VOZ_MOTOR=neutts
# GEMINI_API_KEY=       # sólo con VOZ_MOTOR=gemini: https://aistudio.google.com/apikey

# NeuTTS nano-spanish: los dos repos son *gated*: hay que aceptar sus términos una vez en huggingface.co/neuphonic/neutts-nano-spanish y
# .../neucodec con esta misma cuenta, o la descarga responde 403.
HF_TOKEN=
# Con todo ya descargado, no preguntar a Hugging Face si hay versiones nuevas:
# ahorra ~3 s de arranque. Quítalo si falta bajar algún modelo.
# HF_HUB_OFFLINE=1

# En macOS hace falta espeak-ng del sistema: `brew install espeak-ng`. El que
# trae neutts viene con una ruta de build rota (ver voice.py).
# NEUTTS_DEVICE=auto    # auto = mps si lo hay, si no cpu. En un M2, mps va
#                       # 1,3 veces más rápido pero arranca 35 s más lento.
# NEUTTS_RMS=0.09        # volumen de salida; sube si la sala es ruidosa
# NEUTTS_TEMPERATURA=1.0
# NEUTTS_SEED=0

# Calidad de lo pre-grabado (muletillas y respuestas frecuentes). En vivo no se
# puede repetir una frase; grabándola sí, y es lo que evita que un badge
# conteste con voz de hombre. Subir los intentos o la nota mínima alarga el
# primer arranque y no toca la latencia de una respuesta en vivo.
# NEUTTS_INTENTOS=6             # tomas como máximo por frase grabada
# NEUTTS_ACEPTABLE=0.6          # nota de 0 a 1 para dar una toma por buena
# NEUTTS_TEMPERATURA_GRABADA=0.7

# Voz en vivo (src/gabriela/vivo.py): NeuTTS con el backbone en GGUF por
# llama.cpp. Ver README, «La voz en vivo».
# VIVO_GGUF=assets/models/neutts-nano-spanish-f16.gguf   # ruta o repo de HF
# VIVO_DEVICE=auto      # auto = Metal si lo hay, si no CPU
# VIVO_INTENTOS=3       # tomas como máximo si una suena a otra voz
# VIVO_COLCHON=1.3      # margen del audio que se junta antes de empezar a sonar;
#                       # súbelo si se corta a media respuesta

# Modo IA (`uv run gabriela --ia`): todo lo contesta Claude Haiku (de pago), sin
# frecuentes ni LLM local, que ni se cargan; sólo la voz y Whisper siguen siendo
# locales. Sin clave no arranca. MODO=ia hace lo mismo con uvicorn o en Docker.
# MODO=local
# Clave en https://platform.claude.com/settings/keys
# ANTHROPIC_KEY=
# IA_MODELO=claude-haiku-5-5
# IA_ESFUERZO=low       # low | medium | high: más, más lento
