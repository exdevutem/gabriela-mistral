# Google AI Studio: una clave para el texto y la voz. Gratis y sin tarjeta en
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcionales. Los modelos más baratos a octubre de 2026; Google los retira con
# fecha (ai.google.dev/gemini-api/docs/deprecations).
# LLM_MODEL=gemini-3.1-flash-lite     # se apaga el 7-may-2027 -> gemini-3.5-flash-lite
# LLM_RAZONAMIENTO=minimal            # "none" si usas gemini-2.5-flash-lite
# GEMINI_TTS_MODELO=gemini-3.8-flash-lite-tts
# GEMINI_VOZ=Gacrux                   # o Sulafat, Vindemiatrix
# GEMINI_ESTILO=Mujer chilena mayor, maestra. Habla pausada, grave y cálida.

# Voz en local en vez de Gemini: VOZ_MOTOR=neutts (clona la referencia) o piper.
# VOZ_MOTOR=gemini

# Otro proveedor compatible con OpenAI (Groq, p. ej.): LLM_URL, LLM_MODEL y su
# LLM_API_KEY. Para un modelo local (llama-server en el puerto 8080), deja
# GEMINI_API_KEY vacía o usa VOZ_MOTOR local, y descomenta:
# LLM_URL=http://127.0.0.1:8080/v1/chat/completions
# LLM_MODEL=local

# Sólo con VOZ_MOTOR=neutts. NeuTTS nano-spanish: los dos repos son *gated*: hay que aceptar sus
# términos una vez en huggingface.co/neuphonic/neutts-nano-spanish y
# .../neucodec con esta misma cuenta, o la descarga responde 403.
HF_TOKEN=

# En macOS hace falta espeak-ng del sistema: `brew install espeak-ng`. El que
# trae neutts viene con una ruta de build rota (ver voice.py).
# NEUTTS_DEVICE=auto    # auto = mps si lo hay, si no cpu. En un M2, mps va
#                       # 1,3 veces más rápido pero arranca 35 s más lento.
# NEUTTS_RMS=0.09        # volumen de salida; sube si la sala es ruidosa
# NEUTTS_TEMPERATURA=1.0
# NEUTTS_SEED=0

# Calidad de lo pre-grabado (muletillas y respuestas frecuentes). En vivo no se
# puede repetir una frase; grabándola sí, y es lo que evita que un badge
# conteste con voz de hombre. Subir los intentos o la nota mínima alarga el
# primer arranque y no toca la latencia de una respuesta en vivo.
# NEUTTS_INTENTOS=6             # tomas como máximo por frase grabada
# NEUTTS_ACEPTABLE=0.6          # nota de 0 a 1 para dar una toma por buena
# NEUTTS_TEMPERATURA_GRABADA=0.7
