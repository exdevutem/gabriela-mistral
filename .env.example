# Chat: cualquier API compatible con OpenAI. Por defecto Groq.
# Saca la clave gratis y sin tarjeta en https://console.groq.com/keys
LLM_API_KEY=

# Opcionales. Groq retira modelos cada pocos meses: si da 404, lista los vivos con
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $LLM_API_KEY"
# LLM_MODEL=qwen/qwen3.8-27b

# Para volver a un modelo local (llama-server en el puerto 8080), deja
# LLM_API_KEY vacía y descomenta:
# LLM_URL=http://127.0.0.1:8080/v1/chat/completions
# LLM_MODEL=local

# Voz: NeuTTS nano-spanish. Los dos repos son *gated*: hay que aceptar sus
# términos una vez en huggingface.co/neuphonic/neutts-nano-spanish y
# .../neucodec con esta misma cuenta, o la descarga responde 403.
HF_TOKEN=

# En macOS hace falta espeak-ng del sistema: `brew install espeak-ng`. El que
# trae neutts viene con una ruta de build rota (ver voice.py).
# NEUTTS_DEVICE=cpu
# NEUTTS_RMS=0.09        # volumen de salida; sube si la sala es ruidosa
# NEUTTS_TEMPERATURA=1.0
# NEUTTS_SEED=0
